{
  "entities": {
    "users": {
      "title": "User",
      "description": "User profiles registered with credential auth or Google SSO",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID generated by Firebase Auth"
        },
        "name": {
          "type": "string",
          "description": "Full name or screen name of the user"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "role": {
          "type": "string",
          "enum": ["Super Admin", "Vendor/Seller", "Customer", "Support Staff", "Delivery Manager"],
          "description": "Access control classification role"
        },
        "walletBalance": {
          "type": "number",
          "description": "Starting balance in BDT"
        },
        "loyaltyPoints": {
          "type": "number",
          "description": "Acquired loyalty shopping points"
        }
      },
      "required": ["id", "name", "email", "role", "walletBalance", "loyaltyPoints"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "users",
      "description": "Collection storing security-constrained user information profiles"
    }
  }
}
